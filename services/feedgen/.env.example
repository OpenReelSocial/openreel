# Copy to .env for local development. Never commit real secrets.
PORT=3002
NODE_ENV=development
LOG_LEVEL=info
# Feeds to serve (docs/architecture/feeds.md). Defaults to services/feedgen/feeds.json.
# FEEDGEN_FEEDS_FILE=/path/to/feeds.json
# Authority of advertised feed URIs; must match the AppView's DEFAULT_FEED_URI.
# FEEDGEN_PUBLISHER=openreel.social
