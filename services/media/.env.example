# Copy to .env for local development. Never commit real secrets.
# See docs/architecture/media.md for the full list.
PORT=3005
NODE_ENV=development
# Where renditions are published: fs (default, local Compose) or s3 (AWS).
MEDIA_STORE=fs
# fs: directory the media CDN serves.
MEDIA_ROOT=/media
# s3: bucket name; region and credentials come from the AWS SDK default chain
# (AWS_REGION, the EC2 instance role).
# MEDIA_S3_BUCKET=
