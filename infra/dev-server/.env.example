# Template for /srv/openreel/.env on the dev server. Never commit real values.
#
# The deploy job runs scripts/init-env.sh before every deploy: it creates the
# file from this template on first run and fills any empty secret below with a
# generated value. Existing values are never overwritten, so rotation is a
# deliberate manual edit.

# Public hostname nginx serves with TLS. The PDS puts this in every DID document
# it creates, so changing it later strands existing accounts.
PDS_HOSTNAME=openreel.zackmurry.com
# Account handles are <name><domain>, e.g. alice.openreel.zackmurry.com.
PDS_SERVICE_HANDLE_DOMAINS=.openreel.zackmurry.com
# Set to false to allow open sign-up. With true, create invite codes using
# PDS_ADMIN_PASSWORD (see README.md).
PDS_INVITE_REQUIRED=true

# Generated by scripts/init-env.sh when empty.
POSTGRES_PASSWORD=
PLC_DB_PASSWORD=
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# Written by the deploy job: the Git SHA of the running images.
IMAGE_TAG=latest
