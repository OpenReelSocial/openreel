# Copy to infra/pds/.env (git-ignored) or run 'make pds-secrets' to generate
# the three required values. Never commit real values, and never reuse a secret
# from a deployed PDS here.

# Public hostname the PDS advertises. Deployed environments use a real
# openreel.social subdomain behind TLS (see docs/adr/0001); the domain is
# registered and the namespace claim depends on it.
#   deployed: PDS_HOSTNAME=pds.openreel.social, PDS_DEV_MODE=false
PDS_HOSTNAME=localhost
PDS_EXPOSED_PORT=3000
# This is the PUBLIC PLC directory. Do not create accounts on the local PDS
# while it points here: each account publishes a permanent did:plc entry whose
# service endpoint is http://localhost:3000. Local account creation needs a
# local PLC server (upstream did-method-plc) or an explicit decision to accept
# public entries; that is deferred to the integration harness (DEV-041/044/045).
PDS_DID_PLC_URL=https://plc.directory

# Required locally: @atproto/pds rejects a non-https OAuth resource URL, which is
# unavoidable with a plain-http localhost hostname. Must be false when deployed.
PDS_DEV_MODE=true

# Generate with 'make pds-secrets', or by hand:
#   PDS_JWT_SECRET                             openssl rand -hex 16
#   PDS_ADMIN_PASSWORD                         openssl rand -hex 16
#   PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX  openssl ecparam -name secp256k1 -genkey -noout -outform DER | tail -c +8 | head -c 32 | xxd -p -c 32
PDS_JWT_SECRET=
PDS_ADMIN_PASSWORD=
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=
