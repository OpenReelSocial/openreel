# Copy to .env and fill in. .env is git-ignored; never commit real values.
#
# Naming convention: <COMPONENT>_<SETTING>, uppercase snake case. Service-specific
# settings live in that service's own .env.example (e.g. services/appview).

# --- Local Postgres (compose) ---
POSTGRES_USER=openreel
POSTGRES_PASSWORD=openreel_dev
POSTGRES_DB=openreel
# Change if a local Postgres already owns 5432.
POSTGRES_PORT=5432
# Host-side connection string for 'make db-migrate', 'db-status', 'db-reset'.
# Leave commented to derive it from the POSTGRES_* values above; set it only to
# point at a different database. Containers get the postgres:5432 variant from
# compose.yaml, not this value.
# DATABASE_URL=postgres://openreel:openreel_dev@localhost:5432/openreel

# --- Local Redis (compose) ---
REDIS_PORT=6379

# --- Service host ports ---
APPVIEW_PORT=3001
FEEDGEN_PORT=3002
# Admin status page, bound to 127.0.0.1 only.
ADMIN_PORT=3003
