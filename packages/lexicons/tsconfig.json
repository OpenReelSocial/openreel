{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // @atproto/lex-cli output is written against upstream's compiler settings and
    // does not typecheck under exactOptionalPropertyTypes. Relaxed for this
    // package only; consumers keep the strict base.
    "exactOptionalPropertyTypes": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
